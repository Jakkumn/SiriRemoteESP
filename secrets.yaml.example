# Copy this file to secrets.yaml and fill in real values:
#
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml
#
# secrets.yaml is gitignored — your real credentials never get committed.

# Wi-Fi credentials for the bridge to join your network.
wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"

# ESPHome API encryption key. Generate a fresh 32-byte base64 key with:
#
#   python -c 'import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())'
#
# Paste the same value into Home Assistant when adding the device through
# the ESPHome integration.
api_key: "REPLACE_WITH_BASE64_KEY"

# Password for OTA firmware uploads from `esphome run`. Any non-empty string;
# remember it for future reflashes.
ota_password: "REPLACE_WITH_OTA_PASSWORD"
