# Use NimBLE instead of Bluedroid. Smaller, better central-role support,
# and matches the ESP-IDF blecent reference we're building from.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Central + observer; we never advertise.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# Peripheral role enabled to register a minimal GATT server (GAP + GATT
# standard services). Apple's BLE accessory firmware probes the central's
# GATT and disconnects after a window of failed queries — keeping a passive
# server up satisfies those probes. We never advertise; this is server-only.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# MTU headroom — Apple grants large MTUs; leaves room for 101-byte audio
# reports if we ever want them.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Bonding: Just Works + Secure Connections, keys persisted in NVS.
# Note: bonding itself is enabled at runtime via ble_hs_cfg.sm_bonding = 1
# (in siri_ble.c) — there's no Kconfig flag for it.
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Flash + partition layout — WROOM-32 ships with 4 MB flash; the default 1 MB
# factory partition overflows once Wi-Fi + MQTT join BLE in Phase 2.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Wi-Fi + BLE coexistence on a single 2.4 GHz radio.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Quality-of-life log output over UART.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
